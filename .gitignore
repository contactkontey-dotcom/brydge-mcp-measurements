# Scratch space for runs: installs, sandboxes, full traces.
work/
# Results that are held for disclosure. They are never committed here until
# 30 days after the maintainer was told; see README.
held/
/node_modules
# Calibration raw runs are regenerated by `node measure.ts calibrate`; only the
# pass/fail summary (calibration/result.json) is committed, as the gate proof.
calibration/runs/
# Python build byproducts from installing the local calibration package
__pycache__/
*.pyc
*.egg-info/
calibration/liar-python/build/
