# Scratch space for runs: installs, sandboxes, full traces.
work/
# Results that are held for disclosure. They are never committed here until
# 30 days after the maintainer was told; see README.
held/
/node_modules
# Calibration raw runs are regenerated by `node measure.ts calibrate`; only the
# pass/fail summary (calibration/result.json) is committed, as the gate proof.
calibration/runs/
# Python build byproducts from installing the local calibration package
__pycache__/
*.pyc
*.egg-info/
calibration/liar-python/build/
# The built site. Regenerated by `node site/build.ts` from the evidence; the
# generator and the cleared list are the source, the output is not.
site/dist/
site/preview/
# Update Watch stores a full evidence file per run, two runs per version, and
# they accumulate with every version measured. The diffs are the output worth
# keeping; the runs behind them are regenerated by `node watch/cli.ts measure`.
watch/runs/
# Customer lists are not in this repository at all any more: they live in the
# private brydge-watch repo. See watch/CUSTOMERS.md. The rule stays so that a
# stray local file cannot be committed by accident.
watch/customers/
# The audit log's records. They are derived: `node watch/cli.ts backfill`
# rebuilds every one of them from watch/runs/. Kept out until there is a
# decision about publishing them, since the format does not change either way.
watch/log/
